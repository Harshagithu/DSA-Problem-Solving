
Input :- arr1 = [1,3,5] arr2 = [2,1,4,5,7,8,9]
Output :- arr = [1,5]

Brute Force :-
==============

func(nums1,nums2)
{
  Set<Integer> hs=new HashSet<>();
  Set<Integer> ihs=new HashSet<>();
  for(int i:nums1)
  {
    hs.add(i);
  }
  for(int j:nums2)
  {
    if(hs.contains(j))
    {
      ihs.add(j);
    }
  }
  return new ArrayList<>(ihs);
}

Time Complexity :- O(n1logn1) + O(n2logn2)
Space Complexity :- O(n1) + O(n2)

Optimal Approach :-
===================

func(nums1,nums2)
{
 int n1=nums1.length;
 int n2=nums2.length;
 int i=0;
 int j=0;
 ArrayList<Integer> res=new ArrayList<>();
 while(i<n1&&j<n2)
 {
   if(nums1[i]<nums2[j])
   {
    i++;
   }
   else if(nums1[i]>nums2[j])
   {
    j++;
   }
  else
  {
    if(res.isEmpty()||res.get(res.size()-1)!=nums1[i])
    {
       res.add(nums1[i]);
    }
    i++;
    j++;
  }
  
 }
 return res;
}

Time Complexity :- O(n1+n2)
Space Complexity :- O(1)
